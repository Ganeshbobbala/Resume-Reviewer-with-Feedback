# =========================================================================
# Resume Reviewer & Feedback AI Platform — Environment Variables
# Copy this file to .env and configure for your local/production environment
# NEVER commit real API keys or credentials to version control.
# =========================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting & Resource Caps
MAX_FILE_SIZE_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60

# Supabase Storage & Database (Optional persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key

# Feature Flags
ENABLE_SEMANTIC_MATCHING=true
ENABLE_RAG=true
ENABLE_LLM_FEEDBACK=true

# Embedding Configuration (Hybrid Semantic Matcher & RAG)
# Options: "sentence-transformers/all-MiniLM-L6-v2" or "fast-lightweight"
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider Configuration
# Supported providers: "mock", "rule_based", "openai", "gemini", "anthropic", "ollama", "lora"
LLM_PROVIDER=rule_based
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Fine-Tuning / LoRA Configuration (Stage 7 - Optional)
LORA_BASE_MODEL=meta-llama/Llama-3.2-1B-Instruct
LORA_ADAPTER_PATH=./training/lora_adapters/best_checkpoint

